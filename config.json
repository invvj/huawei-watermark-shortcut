  "templateHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Watermark</title>\n    <style>\n        html, body {\n            margin: 0;\n            padding: 0;\n            background: transparent;\n        }\n        /* 整张画布透明，只让右下角的水印单元显示出来（叠加用） */\n        .watermark-root {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n        }\n        /* 紧凑单元：锚定右下角，像真机华为水印那样 */\n        .hw-unit {\n            position: absolute;\n            right: calc(__HEIGHT__ * 0.045px);\n            bottom: calc(__HEIGHT__ * 0.045px);\n            font-family: \"HarmonyOS Sans SC\", \"HarmonyOS Sans\", \"PingFang SC\", \"Helvetica Neue\", Arial, sans-serif;\n            color: var(--text);\n            font-size: calc(__HEIGHT__ * 0.026px);\n            line-height: 1.2;\n            text-align: left;\n            text-shadow: var(--shadow);\n            user-select: none;\n        }\n        .hw-row {\n            display: flex;\n            align-items: center;\n            gap: calc(__HEIGHT__ * 0.014px);\n        }\n        .hw-logo {\n            display: flex;\n            align-items: center;\n        }\n        .logo-size {\n            height: calc(__HEIGHT__ * 0.034px);\n            width: auto;\n            display: block;\n        }\n        .logo-color {\n            fill: var(--accent);\n        }\n        .hw-name {\n            display: flex;\n            align-items: baseline;\n            white-space: nowrap;\n        }\n        .hw-brand {\n            font-weight: 800;\n            letter-spacing: 0.04em;\n        }\n        .hw-model {\n            font-weight: 500;\n            letter-spacing: 0.02em;\n            margin-left: calc(__HEIGHT__ * 0.006px);\n        }\n        .hw-xmage {\n            color: var(--accent);\n            font-weight: 800;\n            letter-spacing: 0.08em;\n            font-size: 0.92em;\n            margin-left: calc(__HEIGHT__ * 0.006px);\n        }\n        .hw-params {\n            font-weight: 500;\n            opacity: 0.92;\n            margin-top: calc(__HEIGHT__ * 0.004px);\n            font-size: 0.78em;\n            letter-spacing: 0.02em;\n            white-space: nowrap;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"watermark-root\">\n        <div class=\"hw-unit\" id=\"hwUnit\">\n            <div class=\"hw-row\">\n                <div class=\"hw-logo\">__LOGO__</div>\n                <div class=\"hw-name\">\n                    <span class=\"hw-brand\" id=\"hwBrand\"></span>\n                    <span class=\"hw-model\" id=\"hwModel\"></span>\n                </div>\n                <div class=\"hw-xmage\">XMAGE</div>\n            </div>\n            <div class=\"hw-params\" id=\"hwParams\"></div>\n        </div>\n    </div>\n    <script>\n        const customDisplay = \"__CUSTOM__\";\n        const imageJson = __METADATA__ ;\n\n        // 强制使用快捷指令注入的机型（华为 Mate X6/X7），不被照片自带 TIFF Model 覆盖\n        const cameraModel = \"__MODEL__\";\n        const brand = cameraModel.split(' ')[0];\n        const model = cameraModel.split(' ').slice(1).join(' ');\n        document.getElementById('hwBrand').textContent = brand;\n        document.getElementById('hwModel').textContent = model;\n\n        // 读取源照片真实 EXIF（每张照片参数不同，按原图来）\n        const { FocalLenIn35mmFilm: focalLength = 24, FNumber: fNumber = 1.8, ExposureTime: exposureTimeRaw = 1 / 60, ISOSpeedRatings: iso = 100 } = imageJson[\"{Exif}\"] ?? {};\n        const exposureTime = exposureTimeRaw < 1 ? Math.round(1 / exposureTimeRaw) : Math.round(exposureTimeRaw);\n\n        const cameraSettings = `${focalLength}mm · ƒ/${fNumber.toFixed(2)} · 1/${exposureTime}s · ISO${iso}`;\n        document.getElementById('hwParams').textContent = customDisplay ? customDisplay : cameraSettings;\n\n        const themes = {\n            // 浅色：白字 + 暗阴影（适合深色/夜景照片）\n            Light: { text: '#FFFFFF', accent: '#CF0A2C', shadow: '0 0 2px rgba(0, 0, 0, 0.45)' },\n            // 深色：纯黑字无阴影（适合浅色/白天照片）\n            Dark:  { text: '#000000', accent: '#CF0A2C', shadow: 'none' }\n        };\n        const setTheme = (themeName) => {\n            const t = themes[themeName] || themes.Light;\n            const root = document.documentElement;\n            root.style.setProperty('--text', t.text);\n            root.style.setProperty('--accent', t.accent);\n            root.style.setProperty('--shadow', t.shadow);\n        };\n        setTheme('__THEME__');\n    </script>\n</body>\n</html>\n",
  "modelOptions": [
    "HUAWEI Mate X6",
    "HUAWEI Mate X7"
  ],
  "promptModel": "请选择华为机型"
}